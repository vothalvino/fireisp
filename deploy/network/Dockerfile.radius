FROM debian:bookworm-slim
ARG FIREISP_RELEASE=development
LABEL org.opencontainers.image.revision=$FIREISP_RELEASE
RUN apt-get update && apt-get install -y --no-install-recommends freeradius freeradius-rest python3 && rm -rf /var/lib/apt/lists/*
COPY deploy/network/radius_entry.py /opt/fireisp-radius/entry.py
COPY deploy/network/accounting_replay.py /opt/fireisp-radius/accounting_replay.py
COPY deploy/network/radius_daemon.py /opt/fireisp-radius/radius_daemon.py
RUN chmod -R a+rX /opt/fireisp-radius
ENTRYPOINT ["python3", "/opt/fireisp-radius/entry.py"]
